+    // GRAM_DIR / GRAM_MATCH: full per-expert input Gram X^T X for matching MUL_MAT_ID weights (and, patch 0012,
+    // one per 2D matrix for matching dense MUL_MAT weights), pooled over all
+    // visits of a layer (for GPTQ-style rounding). Upper triangle only; raw f32 [n_as][ne0][ne0] plus int64 counts.
+    struct Gram { int64_t ne0 = 0; std::vector<float> g; std::vector<int64_t> n; std::vector<std::vector<float>> pend; };
+    // rows wait per expert until GRAM_FLUSH (default 256) of them can go into one ssyrk: a call carries only about
+    // 32 rows per expert, and updating the whole ne0^2 triangle for so few rows is bound by memory traffic
+    static void gram_flush(Gram & gr, int64_t ex) {
+#ifdef __APPLE__
+        auto & p = gr.pend[ex];
+        const int64_t k = (int64_t) (p.size() / gr.ne0);
+        if (k == 0) { return; }
+        cblas_ssyrk(CblasRowMajor, CblasUpper, CblasTrans, (int) gr.ne0, (int) k, 1.0f, p.data(), (int) gr.ne0,
+                    1.0f, gr.g.data() + (size_t) ex * gr.ne0 * gr.ne0, (int) gr.ne0);
+        gr.n[ex] += k;
+        p.clear();
+#endif
+    }
+    std::unordered_map<std::string, Gram>   m_grams;
+    int                                     m_gram_on = -1; // -1: env not read yet
+    std::regex                              m_gram_re;
+    bool gram_wanted(const std::string & wname) {
+        if (m_gram_on < 0) {
+            const char * dir = getenv("GRAM_DIR");
+            const char * re  = getenv("GRAM_MATCH");
+            m_gram_on = dir && re ? 1 : 0;
+            if (m_gram_on) { m_gram_re = std::regex(re); }
+        }
+        return m_gram_on == 1 && std::regex_search(wname, m_gram_re);
+    }
