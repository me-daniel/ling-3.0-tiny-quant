+void IMatrixCollector::save_grams() {
+    const char * dir = getenv("GRAM_DIR");
+    if (!dir) { return; }
+    for (auto & [name, gr] : m_grams) {
+        for (int64_t ex = 0; ex < (int64_t) gr.pend.size(); ++ex) { gram_flush(gr, ex); }
+        const std::string base = std::string(dir) + "/" + name;
+        FILE * f = fopen((base + ".gram.f32").c_str(), "wb");
+        FILE * c = fopen((base + ".gram.counts.i64").c_str(), "wb");
+        GGML_ASSERT(f && c);
+        GGML_ASSERT(fwrite(gr.g.data(), sizeof(float), gr.g.size(), f) == gr.g.size());
+        GGML_ASSERT(fwrite(gr.n.data(), sizeof(int64_t), gr.n.size(), c) == gr.n.size());
+        fclose(f); fclose(c);
+        LOG_INF("%s: wrote %s.gram.f32 (%zu experts x %lld^2)\n", __func__, base.c_str(), gr.n.size(), (long long) gr.ne0);
+    }
+}
